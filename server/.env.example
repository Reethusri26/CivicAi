# Copy to .env for local development. Never commit the real .env.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (Database Access user with readWrite on one database).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/civicai?retryWrites=true&w=majority

# Long random string, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Optional separate secret for signed evidence-image URLs (defaults to JWT_SECRET).
FILE_URL_SECRET=

# Comma-separated list of frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173

# First admin account, created only when no admin exists. Remove ADMIN_PASSWORD after first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Gemini (optional). Without a key, complaints use the labelled rule-based classifier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=12000
# Send the first evidence photo to Gemini along with the text.
GEMINI_ANALYZE_IMAGES=false

# Upload limits
MAX_IMAGE_MB=5
MAX_IMAGES_PER_UPLOAD=5
