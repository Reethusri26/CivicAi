# Copy to .env.local for development. In Vercel, set these under Project Settings → Environment Variables.

# Origin of the backend API, without /api and without a trailing slash.
VITE_API_URL=http://localhost:5000

# Optional public support address shown on the landing page.
VITE_SUPPORT_EMAIL=

# Google sign-in (optional): the same OAuth client ID as the API's GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=
